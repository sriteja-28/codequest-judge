# CodeQuest judge worker - example environment file.
#
# `scripts/dev.ps1 setup` copies this to .env and writes the same random
# JUDGE_INTERNAL_API_KEY it puts into backend/.env.
#
# The worker consumes submission jobs from RabbitMQ, runs them in Docker
# (judge/sandbox.py) and posts results back to the backend's internal API.
# Docker must be running and the language images must be built
# (`scripts/dev.ps1 setup` builds them; see judge/README.md).

# --- Backend API -------------------------------------------------------------
# Origin of the Django API WITHOUT the /api prefix (server-to-server, so an IP is fine).
BACKEND_API_URL=http://127.0.0.1:8000
# Shared secret for internal calls. MUST equal JUDGE_INTERNAL_API_KEY in backend/.env.
JUDGE_INTERNAL_API_KEY=judge-secret-key-change-me
# Timeout (seconds) / retries for internal backend calls.
BACKEND_HTTP_TIMEOUT=15
CALLBACK_RETRIES=4

# --- RabbitMQ (dev stack: infra/docker-compose.dev.yml) -------------------------
RABBITMQ_URL=amqp://codequest:codequest_dev@127.0.0.1:5673/
# MUST match JUDGE_QUEUE_NAME in backend/.env.
JUDGE_QUEUE_NAME=code_submissions
# Poison jobs land here for triage. Defaults to "<JUDGE_QUEUE_NAME>.dead".
#JUDGE_DEAD_LETTER_QUEUE=code_submissions.dead
# Requeue policy for infrastructure errors (Docker hiccups etc.).
MAX_JOB_RETRIES=3
RETRY_DELAY_SECONDS=5

# --- Sandbox limits (per test case) --------------------------------------------
CPU_TIME_LIMIT=10
MEMORY_LIMIT_MB=256
# Compilation phase (once per submission).
COMPILE_TIME_LIMIT=30
COMPILE_MEMORY_LIMIT_MB=512
# Docker --cpus per container.
JUDGE_CPUS=1.0
# Largest accepted source file (bytes). Must match backend MAX_CODE_BYTES.
MAX_CODE_BYTES=65536

# --- Test case source ------------------------------------------------------------
# api (default, required in production): fetch test cases from the backend's
#     internal API; test data never ships with the worker.
# db: legacy local mode, read test cases straight from Postgres.
TESTCASE_SOURCE=api
#DATABASE_URL=postgresql://codequest:codequest_dev@127.0.0.1:5433/codequest

# --- Logging ------------------------------------------------------------------------
LOG_LEVEL=INFO
